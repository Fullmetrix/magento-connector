<?php
/** @var \Fullmetrix\Connector\Block\Tracker $block */
/** @var \Magento\Framework\View\Helper\SecureHtmlRenderer $secureRenderer */
if (!$block->shouldRender()) {
    return;
}
$localScriptUrl = $block->getLocalScriptUrl();
$attributesHtml = $block->getTagAttributesHtml($escaper);
?>
<?php if ('' !== $localScriptUrl): ?>
<script
    async
    id="<?= $escaper->escapeHtmlAttr(\Fullmetrix\Connector\Block\Tracker::ELEMENT_ID) ?>"
    src="<?= $escaper->escapeUrl($localScriptUrl) ?>"<?= /* @noEscape */ $attributesHtml ?>

></script>
    <?= /* @noEscape */ $secureRenderer->renderEventListenerAsTag(
        'onerror',
        $block->getRemoteFallbackJs(),
        '#' . \Fullmetrix\Connector\Block\Tracker::ELEMENT_ID
    ) ?>
<?php else: ?>
<script
    async
    id="<?= $escaper->escapeHtmlAttr(\Fullmetrix\Connector\Block\Tracker::ELEMENT_ID) ?>"
    src="<?= $escaper->escapeUrl($block->getTrackerUrl()) ?>"<?= /* @noEscape */ $attributesHtml ?>

></script>
<?php endif; ?>
