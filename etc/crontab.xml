<?xml version="1.0"?>
<config
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd"
>
    <group id="fullmetrix">
        <job name="fullmetrix_flush_webhooks" instance="Fullmetrix\Connector\Cron\FlushWebhooks" method="execute">
            <schedule>* * * * *</schedule>
        </job>
        <job name="fullmetrix_sync_tracker_script"
             instance="Fullmetrix\Connector\Cron\SyncTrackerScript"
             method="execute">
            <schedule>*/10 * * * *</schedule>
        </job>
    </group>
</config>
